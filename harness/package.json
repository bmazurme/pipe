{
  "name": "@pipe/harness",
  "version": "0.1.0",
  "private": true,
  "description": "pipe-status: reads sync's and reports' local state files and prints one merged summary of in-flight tasks. pipe-mcp: the same logic as MCP tools for Claude Code.",
  "type": "module",
  "bin": {
    "pipe-status": "./dist/status.js",
    "pipe-mcp": "./dist/mcp.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "start": "node dist/status.js",
    "test": "tsc -b && node --test 'dist/**/*.test.js'",
    "test:coverage": "tsc -b && node --test --experimental-test-coverage 'dist/**/*.test.js'",
    "lint": "eslint ."
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pipe/protocol": "*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
