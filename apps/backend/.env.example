NODE_ENV=development
PORT=3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ntlstl-db

JWT_SECRET=change-me-access-secret
REFRESH_JWT_SECRET=change-me-refresh-secret

# https://oauth.yandex.ru/ -> create app -> callback = NOTES_YANDEX_REDIRECT
YANDEX_ID=
YANDEX_SECRET=
NOTES_YANDEX_REDIRECT=http://localhost:3000/api/v1/oauth/yandex/redirect

# where the browser is sent after a successful/failed OAuth login
NOTES_TARGET_URL=http://localhost:5173
COOKIE_DOMAIN=localhost

# optional comma-separated email allowlist; leave empty to allow anyone
EMAILS=

CORS_ORIGINS=http://localhost:5173
