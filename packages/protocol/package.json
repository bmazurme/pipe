{
  "name": "@pipe/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Shared parcel protocol (dictionary substitution, zip pack/manifest, hybrid encryption, project walk) for sync/reports/bridge.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./manifest": { "types": "./dist/manifest.d.ts", "default": "./dist/manifest.js" },
    "./encryption": { "types": "./dist/encryption.d.ts", "default": "./dist/encryption.js" },
    "./dictionary": { "types": "./dist/dictionary.d.ts", "default": "./dist/dictionary.js" },
    "./pack": { "types": "./dist/pack.d.ts", "default": "./dist/pack.js" },
    "./walk": { "types": "./dist/walk.d.ts", "default": "./dist/walk.js" },
    "./leakScan": { "types": "./dist/leakScan.d.ts", "default": "./dist/leakScan.js" }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "test": "tsc -b && node --test 'dist/**/*.test.js'"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
