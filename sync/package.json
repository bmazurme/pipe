{
  "name": "sync-cli",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Syncs JS/TS project source trees between machines through bridge's storage API, substituting values<->keys per a local dictionary.",
  "type": "module",
  "bin": {
    "sync-cli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "start": "node dist/cli.js",
    "test": "tsc -b && node --test --test-concurrency=1 'dist/**/*.test.js'",
    "test:coverage": "tsc -b && node --test --experimental-test-coverage --test-concurrency=1 'dist/**/*.test.js'",
    "lint": "eslint ."
  },
  "dependencies": {
    "@pipe/protocol": "*",
    "adm-zip": "^0.6.0",
    "commander": "^12.1.0",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.2",
    "eslint": "^10.12.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
