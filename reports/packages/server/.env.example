# Все переменные опциональны — сервер работает и без .env, с указанными ниже
# значениями по умолчанию. Подробнее см. README.md → «Переменные окружения».

# Порт сервера
PORT=4000

# Хост, на котором слушает сервер
HOST=127.0.0.1

# Через запятую: дополнительные имена хоста, под которыми сервер открывается в
# браузере (например reports.lan). Защита от DNS rebinding — localhost,
# *.localhost и IP-адреса разрешены всегда.
ALLOWED_HOSTS=

# Через запятую: дополнительные источники (CORS), которым разрешено обращаться
# к API (например https://reports.example.com). Локальный клиент разрешён всегда.
CLIENT_ORIGIN=

# Токен GitHub для отслеживаемых GitHub-репозиториев (Settings → «Отслеживаемые
# репозитории»). Нужны права Issues: read & write и Pull requests: read & write
# на нужный репозиторий. Намеренно в .env, а не в Settings — экспорт настроек
# не должен возить этот токен. Для локальной проверки: GITHUB_TOKEN=$(gh auth token)
GITHUB_TOKEN=

# Режим автопилота (heartbeat + автопуллинг без присмотра) — см. SELF_IMPROVEMENT_PLAN.md
REPORTS_AUTOPILOT=

# Путь к файлу props.json со счётчиками, если нужен нестандартный
REPORTS_PROPS_PATH=

# HTTP(S)-прокси для исходящих запросов к GitLab/bridge, если нет прямого
# доступа в интернет (http://user:pass@proxy.company.com:8080)
HTTPS_PROXY=
HTTP_PROXY=
