# Generated by infra/vip/install.sh — the floating address of the bridge stack.
# Both boards run the same file (only the unicast addresses differ). The board that runs Caddy holds the address;
# a board without Caddy drops its priority below the other's and gives the address up. nopreempt: nobody takes it
# back just because it came up.
global_defs {
    script_user root
    enable_script_security
}

vrrp_script check_caddy {
    script "/usr/local/bin/vip-check-caddy"
    interval 5
    fall 2
    rise 2
    weight -50
}

vrrp_instance BRIDGE_VIP {
    state BACKUP
    nopreempt
    interface @IFACE@
    virtual_router_id @VRID@
    priority 100
    advert_int 1
    unicast_src_ip @SELF@
    unicast_peer {
        @PEERS@
    }
    virtual_ipaddress {
        @VIP@/@PREFIX@ dev @IFACE@
    }
    track_script {
        check_caddy
    }
    notify_master "/usr/local/bin/vip-notify MASTER @VIP@"
    notify_backup "/usr/local/bin/vip-notify BACKUP @VIP@"
    notify_fault "/usr/local/bin/vip-notify FAULT @VIP@"
}
