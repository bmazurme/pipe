# APP_HOST / API_HOST come from the container environment (bridge-pi.yml).
#
# lb_try_*: while a service is being replaced (or restarts) there is a moment with no healthy task behind the
# name; Caddy holds the request and retries for up to a minute instead of answering 502, so a release costs a
# slow request, not an error.
{$APP_HOST} {
	encode gzip
	reverse_proxy frontend:80 {
		lb_try_duration 60s
		lb_try_interval 500ms
	}
}

{$API_HOST} {
	encode gzip
	reverse_proxy backend:3000 {
		lb_try_duration 60s
		lb_try_interval 500ms
	}
}

# A static landing page (NTLSTL Proto 450). The files live in the `landing_site` volume: releases/<name>/ and `current`, a symlink to
# the live one. bridge's «Промо → Лендинг» page (or deploy-landing.sh) writes them — the page is not part of any image, so publishing it
# never redeploys bridge. A failover board starts with an empty volume: bridge unpacks the last live release from its file store
# on start; until then (or if it cannot) this host answers 404, bridge itself is not affected.
{$LANDING_HOST} {
	encode zstd gzip
	root * /srv/landing/current
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	@assets path /images/* /fonts/*
	header @assets Cache-Control "public, max-age=86400"
	file_server
}
