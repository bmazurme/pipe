# APP_HOST / API_HOST come from the container environment (bridge-pi.yml).
#
# lb_try_*: while a service is being replaced (or restarts) there is a moment with no healthy task behind the
# name; Caddy holds the request and retries for up to a minute instead of answering 502, so a release costs a
# slow request, not an error.
{$APP_HOST} {
	encode gzip
	reverse_proxy frontend:80 {
		lb_try_duration 60s
		lb_try_interval 500ms
	}
}

{$API_HOST} {
	encode gzip
	reverse_proxy backend:3000 {
		lb_try_duration 60s
		lb_try_interval 500ms
	}
}

# A static landing page (NTLSTL Proto 450). The files live in the `landing_site` volume and are put there by
# deploy-landing.sh — the page is not part of any image, so publishing it never redeploys bridge. A node without the
# volume's content (a failover board) serves a 404 for this host only; bridge itself is not affected.
{$LANDING_HOST} {
	encode zstd gzip
	root * /srv/landing
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	@images path /images/*
	header @images Cache-Control "public, max-age=86400"
	file_server
}
