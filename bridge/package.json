{
  "name": "bridge",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:db && concurrently -n backend,frontend -c blue,green \"npm run start:dev -w backend\" \"npm run dev -w frontend\"",
    "dev:db": "docker compose up -d postgres",
    "dev:backend": "npm run start:dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "lint": "npm run lint -w backend && npm run lint -w frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "class-validator": "^0.15.1"
  },
  "overrides": {
    "multer": "^2.5.0",
    "body-parser": "1.20.9",
    "lodash": "^4.18.1",
    "decode-uri-component": "^0.5.1",
    "@nestjs/swagger": {
      "js-yaml": "^4.3.2"
    }
  }
}
