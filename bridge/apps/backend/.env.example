NODE_ENV=development
PORT=3000

POSTGRES_HOST=localhost
# Matches docker-compose.yml's port mapping (5445:5432), not Postgres's
# default 5432 — that default is for a container reaching another container
# on the same Docker network; this app runs on the host and reaches the
# container through its published port instead.
POSTGRES_PORT=5445
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ntlstl-db

JWT_SECRET=change-me-access-secret
REFRESH_JWT_SECRET=change-me-refresh-secret

# AES-256-GCM key (base64, 32 raw bytes) that encrypts ClaudeCredential.token
# and VpnConnection.panelApiToken at rest — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENC_KEY=

# Uploaded files (Storage parcels, chat attachments): `local` keeps them on the volume under uploads/,
# `s3` puts them in a bucket (any S3 API; path-style). S3_ENDPOINT may list several nodes, comma-separated:
# the next one is tried when the first is down.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# https://oauth.yandex.ru/ -> create app -> callback = BRIDGE_YANDEX_REDIRECT
YANDEX_ID=
YANDEX_SECRET=
BRIDGE_YANDEX_REDIRECT=http://localhost:3000/api/v1/oauth/yandex/redirect

# Optional second sign-in method:
# https://github.com/settings/developers -> New OAuth App -> callback = BRIDGE_GITHUB_REDIRECT
# (leave GITHUB_ID empty to keep GitHub sign-in off — the login page hides the button)
GITHUB_ID=
GITHUB_SECRET=
BRIDGE_GITHUB_REDIRECT=http://localhost:3000/api/v1/oauth/github/redirect

# where the browser is sent after a successful/failed OAuth login
BRIDGE_TARGET_URL=http://localhost:5173
COOKIE_DOMAIN=localhost

# optional comma-separated email allowlist; leave empty to allow anyone
EMAILS=

CORS_ORIGINS=http://localhost:5173

# Which proxy hops Express trusts X-Forwarded-For from. Default (unset/empty):
# loopback — a reverse proxy on the same host. Behind a proxy in another
# container (e.g. Caddy on the Swarm overlay network) set 'uniquelocal'
# (private ranges), a CIDR, or a comma-separated list; otherwise throttling
# and the sessions list lump all clients into the proxy's address.
# TRUST_PROXY=loopback
# TRUST_PROXY=uniquelocal
# TRUST_PROXY=10.0.0.0/8

# (No shared-secret integration keys: machine callers — sync, reports, worker,
# ntlstl.time — all authenticate with a personal API key from the profile page.)

# Self-improvement loop (see SELF_IMPROVEMENT_PLAN.md). All optional — a
# missing value just disables that integration.
# Telegram bot (via @BotFather): notifications + /status. TELEGRAM_CHAT_ID is
# the only chat the bot talks to; register the webhook with
#   setWebhook url=<bridge>/api/v1/telegram/webhook secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# GitHub repo webhook -> POST <bridge>/api/v1/github/webhook, content type
# application/json, events: Pull requests + Workflow runs.
# Leaving it empty makes the webhook route answer every delivery with a 503,
# which the request logger records as http.error (shows up as errors in the
# Logs tab) — set it, or don't register the webhook at all.
GITHUB_WEBHOOK_SECRET=
# Workflow names (the `name:` in .github/workflows) the loop reacts to.
GITHUB_CI_WORKFLOW=CI
GITHUB_DEPLOY_WORKFLOW=Deploy bridge
# Production reaches Telegram only through a proxy (the stack's vpn-client):
#   TELEGRAM_PROXY_URL=http://vpn-client:1080
# and receives updates by long polling instead of a webhook. Opt-in, because
# only one consumer per bot may call getUpdates — don't enable it locally
# against the production bot token.
TELEGRAM_PROXY_URL=
TELEGRAM_POLLING=
# Defaults for quiet hours — editable per account on the profile page, which
# takes precedence once saved. Automatic notifications (heartbeats, CI/deploy
# events, merge offers): inside the window they are held back and delivered as one digest
# when it ends. Replies to your own commands are never delayed. "off" disables.
NOTIFY_QUIET_HOURS=23:00-08:00
NOTIFY_TIMEZONE=Europe/Moscow
# How long operational logs (job outcomes, errors, slow requests; shown and
# exportable on the profile page) are kept. Default 30.
LOG_RETENTION_DAYS=30
# Optional retention for stored files nobody downloaded (abandoned parcels, unread
# results). Files older than this many days are deleted daily at 4am. Unset or 0 = keep
# forever. Must be larger than the longest job runtime.
# STORAGE_RETENTION_DAYS=7
# Merge a green loop PR from Telegram, and run the Improve module (read `loop`
# issues, snapshot the repo, commit a branch, open the PR). Fine-grained token for
# THIS repo only: Issues R, Pull requests RW, Contents RW, Checks R. Empty = no
# merge button and Improve reports "GitHub не настроен".
LOOP_GITHUB_TOKEN=
# owner/name of that repo (set from github.repository in production).
GITHUB_REPO=
# Branch loop PRs must target; anything else is refused. Default main.
GITHUB_BASE_BRANCH=
# Dashboard page: Swarm node status, via a docker-socket-proxy sidecar
# (bridge/deploy/swarm/bridge-stack.yml's docker-proxy service) scoped to
# read-only GET /nodes. Default matches that service's name — only override
# for local/alternate setups.
# DOCKER_PROXY_URL=http://docker-proxy:2375
# Dashboard page: backup status, read straight from Garage S3's
# bridge-backups/LATEST pointer (infra/backup/mirror-s3.sh writes it) — not a
# separate client config, just this bucket's own S3_* values (see
# /etc/garage/keys/bridge-backups.env on the Garage cluster). Empty leaves
# the tile showing "not configured" instead of failing.
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=garage
# BACKUP_S3_BUCKET=bridge-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
