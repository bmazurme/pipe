{
  "_comment": "Inbound MUST be 'http', not 'socks' — the claude CLI's HTTP_PROXY/HTTPS_PROXY support only understands HTTP-style proxies (confirmed: a socks5:// value fails with 'UnsupportedProxyProtocol'), and undici's ProxyAgent (used for the OpenAI-compatible fetch calls) doesn't support SOCKS5 either.",
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 1080,
      "protocol": "http"
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "VPN_SERVER_IP_HERE",
            "port": 443,
            "users": [
              {
                "id": "CLIENT_UUID_HERE",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "REALITY_SNI_HERE",
          "fingerprint": "chrome",
          "publicKey": "REALITY_PUBLIC_KEY_HERE",
          "shortId": "REALITY_SHORT_ID_HERE",
          "spiderX": "/"
        }
      }
    }
  ]
}
