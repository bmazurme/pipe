{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 1080,
      "protocol": "socks",
      "settings": { "udp": true }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "VPN_SERVER_IP_HERE",
            "port": 443,
            "users": [
              {
                "id": "CLIENT_UUID_HERE",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "REALITY_SNI_HERE",
          "fingerprint": "chrome",
          "publicKey": "REALITY_PUBLIC_KEY_HERE",
          "shortId": "REALITY_SHORT_ID_HERE",
          "spiderX": "/"
        }
      }
    }
  ]
}
